name: Sync Fork with Upstream
on:
  schedule:
    - cron: '0 0 * * *'   # 每天 UTC 0 点自动运行一次
  workflow_dispatch:        # 支持手动在 Actions 页面触发

permissions:
  contents: write          # 必须授予写入权限

jobs:
  sync:
    if: github.event.repository.fork  # 仅在 fork 仓库中运行
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false  # 安全考虑，不持久化凭证

      - name: Sync upstream changes
        uses: aormsby/Fork-Sync-With-Upstream-action@v3.4.3  # 建议固定到完整 commit SHA
        with:
          target_sync_branch: main
          upstream_sync_repo: misakano7545/workbuddy2api-panel
          upstream_sync_branch: main
          target_repo_token: ${{ secrets.GITHUB_TOKEN }}
